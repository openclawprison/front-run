# Persistent history. Render injects DATABASE_URL from its managed Postgres service.
DATABASE_URL=
DATABASE_SSL=
INGEST_SECRET=

# X API v2: trends plus recent post counts.
X_BEARER_TOKEN=
X_WOEIDS=23424977
X_COUNT_ENRICH_LIMIT=12
X_POSTS_PER_TREND=10

# YouTube popular-video statistics.
YOUTUBE_API_KEY=
YOUTUBE_REGIONS=US

# TikTok sampled keyword discovery via Bright Data.
BRIGHTDATA_API_TOKEN=
TIKTOK_QUERY_LIMIT=6
TIKTOK_POSTS_PER_QUERY=20
TIKTOK_SEED_QUERIES=america viral,usa meme,usa challenge

# Optional model-written classification and trajectory analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Used only when running the cron trigger outside Render's private network.
FRONT_RUN_URL=http://localhost:3000
